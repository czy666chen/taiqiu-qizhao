{
  "name": "taiqiu-qizhao",
  "version": "6.2.0",
  "description": "面向台球朋友局的中八、多人追分、奇招牌与实时房间应用",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czy666chen/taiqiu-qizhao.git"
  },
  "bugs": {
    "url": "https://github.com/czy666chen/taiqiu-qizhao/issues"
  },
  "homepage": "https://github.com/czy666chen/taiqiu-qizhao#readme",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:static": "vite --config vite.static.config.ts",
    "build": "vinext build",
    "build:preview": "cross-env CLOUDFLARE_ENV=preview vinext build",
    "build:production": "cross-env CLOUDFLARE_ENV=production vinext build",
    "build:static": "vite build --config vite.static.config.ts",
    "deploy:preview": "npm run build:preview && wrangler deploy --env preview",
    "deploy:production": "npm run build:production && wrangler deploy --env production",
    "start": "vinext start",
    "test": "vitest run --config vitest.config.ts",
    "test:worker": "cross-env WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/logs XDG_CONFIG_HOME=.wrangler/xdg vitest run --config vitest.worker.config.ts",
    "test:all": "npm run test && npm run test:worker",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env local",
    "db:migrate:preview": "wrangler d1 migrations apply hei8-r3-preview --remote --env preview",
    "db:migrate:production": "wrangler d1 migrations apply hei8-r3-production-v2 --remote --env production",
    "db:check:local": "wrangler d1 execute DB --local --env local --command \"PRAGMA foreign_key_check; PRAGMA quick_check;\"",
    "security:scan": "node scripts/scan-secrets.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:reset-password": "node scripts/reset-admin-password.mjs",
    "auth:reset-password": "node scripts/reset-password.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.0",
    "wrangler": "^4.120.1"
  },
  "type": "module"
}
